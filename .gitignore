node_modules/
# contract/managed/aegis/ entero va en git: el frontend importa contract/
# (ledger(), tipos) para leer el estado sin pasar por el backend (ver
# frontend/src/chainState.ts), y keys/, zkir/ y compiler/ (~25MB, material
# de prueba ZK) los necesita el backend desplegado en Railway, que construye
# la imagen desde GitHub. Tienen que ser los mismos con los que se desplegó
# el contrato, así que solo se actualizan al recompilar y redesplegar.
# Se usa /* + "!" porque git no evalúa reglas dentro de un directorio ya
# excluido de forma recursiva.
contract/managed/*
!contract/managed/aegis/
dist/
logs/
midnight-level-db/
.env
.contract-address-*
.admin-key-*
.store-key-*
.operator-wallet-seed-*
.operator-wallet-state-*
.claude/settings.local.json
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# Metadatos NTFS de Windows al descargar archivos (no son ficheros reales)
*:Zone.Identifier
.env.local

node_modules/
# El frontend importa el contrato compilado (ledger(), tipos) por ruta
# relativa para leer el estado sin pasar por el backend (ver
# frontend/src/chainState.ts), así que esa subcarpeta sí va en git (~400KB,
# JS/d.ts puro). keys/, zkir/ y compiler/ (~25MB, material de prueba ZK que
# solo usa el backend para probar transacciones) se quedan ignorados: cada
# nivel usa /* (no recursivo) + un "!" al hijo que sí se quiere, porque git
# no evalúa reglas dentro de un directorio ya excluido de forma recursiva.
contract/managed/*
!contract/managed/aegis/
contract/managed/aegis/*
!contract/managed/aegis/contract/
dist/
logs/
midnight-level-db/
.env
.contract-address-*
.admin-key-*
.store-key-*
.operator-wallet-seed-*
.operator-wallet-state-*
.claude/settings.local.json
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# Metadatos NTFS de Windows al descargar archivos (no son ficheros reales)
*:Zone.Identifier

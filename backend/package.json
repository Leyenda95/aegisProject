{
  "name": "@aegis/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "MIDNIGHT_NETWORK=local node --env-file-if-exists=.env --import tsx src/index.ts",
    "start:preprod": "MIDNIGHT_NETWORK=preprod NODE_OPTIONS=--max-old-space-size=6144 node --env-file-if-exists=.env --import tsx src/index.ts",
    "start:preview": "MIDNIGHT_NETWORK=preview NODE_OPTIONS=--max-old-space-size=6144 node --env-file-if-exists=.env --import tsx src/index.ts",
    "setup-operator-wallet": "NODE_OPTIONS=--max-old-space-size=6144 tsx scripts/setup-operator-wallet.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "graphql-ws": "6.2.1",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

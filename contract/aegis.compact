pragma language_version >= 0.20;
import CompactStandardLibrary;

export enum Subcategory {
  // Electronics
  mobile, tablet, computer, camera, audio, gaming,
  // Fashion
  shoes, tops, bottoms, accessories, outerwear,
  // Food
  groceries, restaurant, drinks, snacks,
  // Sports
  equipment, clothing, footwear, supplements,
  // Home
  furniture, appliances, decor, tools,
  // Other
  other
}

// Recibo de compra: dato privado, nunca se guarda tal cual on-chain.
// nonce aporta la aleatoriedad del compromiso (persistentCommit) y hace
// que dos recibos con los mismos valores no produzcan el mismo hash.
export struct Receipt {
  subcategory: Subcategory,
  amount: Uint<64>,
  timestamp: Uint<64>,
  nonce: Bytes<32>,
}

// Main category counters
export ledger signalsElectronics: Counter;
export ledger signalsFashion: Counter;
export ledger signalsFood: Counter;
export ledger signalsSports: Counter;
export ledger signalsHome: Counter;
export ledger signalsOther: Counter;

// Electronics subcategory counters
export ledger signalsMobile: Counter;
export ledger signalsTablet: Counter;
export ledger signalsComputer: Counter;
export ledger signalsCamera: Counter;
export ledger signalsAudio: Counter;
export ledger signalsGaming: Counter;

// Fashion subcategory counters
export ledger signalsShoes: Counter;
export ledger signalsTops: Counter;
export ledger signalsBottoms: Counter;
export ledger signalsAccessories: Counter;
export ledger signalsOuterwear: Counter;

// Food subcategory counters
export ledger signalsGroceries: Counter;
export ledger signalsRestaurant: Counter;
export ledger signalsDrinks: Counter;
export ledger signalsSnacks: Counter;

// Sports subcategory counters
export ledger signalsEquipment: Counter;
export ledger signalsClothing: Counter;
export ledger signalsFootwear: Counter;
export ledger signalsSupplements: Counter;

// Home subcategory counters
export ledger signalsFurniture: Counter;
export ledger signalsAppliances: Counter;
export ledger signalsDecor: Counter;
export ledger signalsTools: Counter;

export ledger totalSignals: Counter;
export ledger campaignCount: Counter;
export ledger isSeeded: Counter;

// --- Registro de tiendas y atestación de recibos ---
//
// Una tienda registrada puede sellar el hash (compromiso) de un recibo sin
// revelar cuál de las tiendas registradas es (prueba de pertenencia al
// árbol Merkle). submitPurchase exige que el recibo del usuario coincida
// con un sello ya publicado antes de revelar categoría/subcategoría.
export sealed ledger admin: Bytes<32>;
export ledger registeredStores: HistoricMerkleTree<10, Bytes<32>>;
export ledger sealedReceipts: Set<Bytes<32>>;
export ledger usedReceipts: Set<Bytes<32>>;

witness local_secret_key(): Bytes<32>;
witness getStorePath(pk: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness getReceipt(): Receipt;

export circuit storePublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "aegis:store:pk:"), sk
  ]);
}

// El compromiso protege sus entradas: no hace falta disclose() sobre los
// campos del recibo ni sobre el resultado.
export circuit receiptCommitment(r: Receipt): Bytes<32> {
  const subcatBytes = (r.subcategory as Field) as Bytes<32>;
  const amountBytes = r.amount as Bytes<32>;
  const timestampBytes = r.timestamp as Bytes<32>;
  return persistentCommit<Vector<3, Bytes<32>>>(
    [subcatBytes, amountBytes, timestampBytes],
    r.nonce,
  );
}

constructor() {
  admin = disclose(storePublicKey(local_secret_key()));
}

// Solo el admin da de alta tiendas verificadas en el árbol.
export circuit registerStore(storePk: Bytes<32>): [] {
  const sk = local_secret_key();
  assert(disclose(storePublicKey(sk) == admin), "Not admin");
  registeredStores.insert(disclose(storePk));
}

// Una tienda registrada sella el hash de un recibo, demostrando que
// pertenece al árbol sin revelar cuál de las tiendas es.
export circuit attestReceipt(commitment: Bytes<32>): [] {
  const sk = local_secret_key();
  const pk = storePublicKey(sk);
  const path = getStorePath(pk);
  const digest = merkleTreePathRoot<10, Bytes<32>>(path);
  assert(registeredStores.checkRoot(disclose(digest)), "Not a registered store");
  sealedReceipts.insert(disclose(commitment));
}

export circuit submitPurchase(): [] {
  const receipt = getReceipt();
  const commitment = disclose(receiptCommitment(receipt));
  assert(sealedReceipts.member(commitment), "Receipt not attested by a registered store");
  assert(!usedReceipts.member(commitment), "Receipt already used");
  usedReceipts.insert(commitment);

  const subcat = receipt.subcategory;
  if (disclose(subcat == Subcategory.mobile)) {
    signalsElectronics.increment(1); signalsMobile.increment(1);
  } else if (disclose(subcat == Subcategory.tablet)) {
    signalsElectronics.increment(1); signalsTablet.increment(1);
  } else if (disclose(subcat == Subcategory.computer)) {
    signalsElectronics.increment(1); signalsComputer.increment(1);
  } else if (disclose(subcat == Subcategory.camera)) {
    signalsElectronics.increment(1); signalsCamera.increment(1);
  } else if (disclose(subcat == Subcategory.audio)) {
    signalsElectronics.increment(1); signalsAudio.increment(1);
  } else if (disclose(subcat == Subcategory.gaming)) {
    signalsElectronics.increment(1); signalsGaming.increment(1);
  } else if (disclose(subcat == Subcategory.shoes)) {
    signalsFashion.increment(1); signalsShoes.increment(1);
  } else if (disclose(subcat == Subcategory.tops)) {
    signalsFashion.increment(1); signalsTops.increment(1);
  } else if (disclose(subcat == Subcategory.bottoms)) {
    signalsFashion.increment(1); signalsBottoms.increment(1);
  } else if (disclose(subcat == Subcategory.accessories)) {
    signalsFashion.increment(1); signalsAccessories.increment(1);
  } else if (disclose(subcat == Subcategory.outerwear)) {
    signalsFashion.increment(1); signalsOuterwear.increment(1);
  } else if (disclose(subcat == Subcategory.groceries)) {
    signalsFood.increment(1); signalsGroceries.increment(1);
  } else if (disclose(subcat == Subcategory.restaurant)) {
    signalsFood.increment(1); signalsRestaurant.increment(1);
  } else if (disclose(subcat == Subcategory.drinks)) {
    signalsFood.increment(1); signalsDrinks.increment(1);
  } else if (disclose(subcat == Subcategory.snacks)) {
    signalsFood.increment(1); signalsSnacks.increment(1);
  } else if (disclose(subcat == Subcategory.equipment)) {
    signalsSports.increment(1); signalsEquipment.increment(1);
  } else if (disclose(subcat == Subcategory.clothing)) {
    signalsSports.increment(1); signalsClothing.increment(1);
  } else if (disclose(subcat == Subcategory.footwear)) {
    signalsSports.increment(1); signalsFootwear.increment(1);
  } else if (disclose(subcat == Subcategory.supplements)) {
    signalsSports.increment(1); signalsSupplements.increment(1);
  } else if (disclose(subcat == Subcategory.furniture)) {
    signalsHome.increment(1); signalsFurniture.increment(1);
  } else if (disclose(subcat == Subcategory.appliances)) {
    signalsHome.increment(1); signalsAppliances.increment(1);
  } else if (disclose(subcat == Subcategory.decor)) {
    signalsHome.increment(1); signalsDecor.increment(1);
  } else if (disclose(subcat == Subcategory.tools)) {
    signalsHome.increment(1); signalsTools.increment(1);
  } else {
    signalsOther.increment(1);
  }
  totalSignals.increment(1);
}

export circuit seed(
  initMobile: Uint<16>, initTablet: Uint<16>, initComputer: Uint<16>,
  initCamera: Uint<16>, initAudio: Uint<16>, initGaming: Uint<16>,
  initShoes: Uint<16>, initTops: Uint<16>, initBottoms: Uint<16>,
  initAccessories: Uint<16>, initOuterwear: Uint<16>,
  initGroceries: Uint<16>, initRestaurant: Uint<16>, initDrinks: Uint<16>, initSnacks: Uint<16>,
  initEquipment: Uint<16>, initClothing: Uint<16>, initFootwear: Uint<16>, initSupplements: Uint<16>,
  initFurniture: Uint<16>, initAppliances: Uint<16>, initDecor: Uint<16>, initTools: Uint<16>,
  initOther: Uint<16>,
  totalElectronics: Uint<16>, totalFashion: Uint<16>, totalFood: Uint<16>,
  totalSports: Uint<16>, totalHome: Uint<16>,
  grandTotal: Uint<16>
): [] {
  assert(disclose(isSeeded.read() == 0), "Already seeded");

  signalsMobile.increment(disclose(initMobile));
  signalsTablet.increment(disclose(initTablet));
  signalsComputer.increment(disclose(initComputer));
  signalsCamera.increment(disclose(initCamera));
  signalsAudio.increment(disclose(initAudio));
  signalsGaming.increment(disclose(initGaming));

  signalsShoes.increment(disclose(initShoes));
  signalsTops.increment(disclose(initTops));
  signalsBottoms.increment(disclose(initBottoms));
  signalsAccessories.increment(disclose(initAccessories));
  signalsOuterwear.increment(disclose(initOuterwear));

  signalsGroceries.increment(disclose(initGroceries));
  signalsRestaurant.increment(disclose(initRestaurant));
  signalsDrinks.increment(disclose(initDrinks));
  signalsSnacks.increment(disclose(initSnacks));

  signalsEquipment.increment(disclose(initEquipment));
  signalsClothing.increment(disclose(initClothing));
  signalsFootwear.increment(disclose(initFootwear));
  signalsSupplements.increment(disclose(initSupplements));

  signalsFurniture.increment(disclose(initFurniture));
  signalsAppliances.increment(disclose(initAppliances));
  signalsDecor.increment(disclose(initDecor));
  signalsTools.increment(disclose(initTools));

  signalsElectronics.increment(disclose(totalElectronics));
  signalsFashion.increment(disclose(totalFashion));
  signalsFood.increment(disclose(totalFood));
  signalsSports.increment(disclose(totalSports));
  signalsHome.increment(disclose(totalHome));
  signalsOther.increment(disclose(initOther));

  totalSignals.increment(disclose(grandTotal));

  isSeeded.increment(1);
}

export circuit registerCampaign(): Uint<64> {
  const id = campaignCount.read();
  campaignCount.increment(1);
  return id;
}
